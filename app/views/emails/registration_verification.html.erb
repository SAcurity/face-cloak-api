<!doctype html>
<html lang="en">
  <body style="margin:0; padding:0; background:#f6f6f6; color:#171717; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">
      Thanks for joining FaceCloak.
    </div>
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent;">
      &zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f6f6f6; padding:28px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px; background:#ffffff; border:1px solid #e5e5e5; border-radius:8px;">
            <tr>
              <td style="padding:56px 72px 48px;">
                <h1 style="margin:0 0 48px; color:#171717; font-size:32px; line-height:40px; font-weight:700;">
                  Sign up for FaceCloak
                </h1>

                <p style="margin:0 0 32px; color:#171717; font-size:20px; line-height:32px;">
                  Thanks for joining FaceCloak!
                </p>

                <p style="margin:0 0 32px; color:#171717; font-size:20px; line-height:32px;">
                  Activate your account to continue:
                </p>

                <table role="presentation" cellspacing="0" cellpadding="0" width="100%" style="margin:0 0 32px;">
                  <tr>
                    <td align="center" style="border-radius:6px; background:#111111;">
                      <a href="<%= verification_url %>" style="display:block; padding:16px 24px; color:#ffffff; font-size:18px; line-height:24px; font-weight:700; text-decoration:none; border-radius:6px;">
                        Activate Account
                      </a>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 32px; color:#171717; font-size:20px; line-height:32px;">
                  This link expires in 30 minutes.
                </p>

                <hr style="border:0; border-top:1px solid #e5e5e5; margin:64px 0 32px;">

                <p style="margin:0 0 18px; color:#777777; font-size:16px; line-height:26px;">
                  If you didn't request this, ignore this email. No account will be created.
                </p>
                <p style="margin:18px 0 0; color:#9a9a9a; font-size:14px; line-height:22px;">
                  Copyright &copy; 2026 FaceCloak. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
